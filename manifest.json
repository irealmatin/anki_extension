{
  "manifest_version": 3,
  "name": "آنکی کنکور | Konkur Anki Vocabulary",
  "version": "1.0.0",
  "description": "مرور هوشمند لغات زبان و کنکور به روش تکرار با فاصله (Anki SM-2) با قابلیت تفکیک خودکار لیست لغات (word = meaning)",
  "action": {
    "default_title": "آنکی کنکور (مرور لغات)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}